{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_command|check_work",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "python \"$NEXUS_HOME/hooks/guard_shell.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "python \"$NEXUS_HOME/hooks/guard_writes.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "python \"$NEXUS_HOME/hooks/screen_prompt.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "timeout": 8,
            "command": "python \"$NEXUS_HOME/hooks/strip_invisible.py\""
          }
        ]
      }
    ]
  }
}